{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "restricted-safe.schema.json",
  "title": "Restricted Safe",
  "description": "A Safe v1.5.0 with Zodiac Roles operational keys and Safe Policy Engine as both guards, deployed in one transaction by script/factory/DeployRestrictedSafe.s.sol. See docs/SAFE_FACTORY.md. Keys starting with '_' are comments and are ignored.",
  "type": "object",
  "required": ["name", "safe", "roles"],
  "properties": {
    "name": {
      "description": "Label for the deployment record (deployments/restricted-safes/<chainId>-<name>.json). Not stored on chain.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "safe": {
      "type": "object",
      "required": ["owners", "threshold"],
      "properties": {
        "owners": { "type": "array", "items": { "$ref": "#/$defs/address" }, "minItems": 1, "uniqueItems": true },
        "threshold": { "type": "integer", "minimum": 1 },
        "saltNonce": {
          "description": "Changes the Safe address for the same configuration. Default 0.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "policyEngine": {
      "type": "object",
      "properties": {
        "delay": {
          "description": "Seconds between requesting and applying a Policy Engine change. Default 86400 (1 day).",
          "type": "integer",
          "minimum": 0
        },
        "expiry": {
          "description": "Seconds a requested change stays applicable after the delay. Default 604800 (7 days).",
          "type": "integer",
          "minimum": 1
        },
        "ownerSwapMaxAbsent": {
          "description": "Safe.swapOwner needs the signatures of all owners but this many, and always more than the threshold. Default 1.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "permissions"],
        "properties": {
          "name": { "description": "1 to 31 bytes.", "type": "string", "minLength": 1, "maxLength": 31 },
          "key": {
            "description": "Role key. Default: the name as bytes32 (the Zodiac Roles app convention).",
            "$ref": "#/$defs/bytes32"
          },
          "members": {
            "description": "Operational keys (EOAs, KMS/HSM keys, or contracts). Never a Safe owner.",
            "type": "array",
            "items": { "$ref": "#/$defs/address" },
            "uniqueItems": true
          },
          "permissions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/permission" } }
        }
      }
    },
    "ownerWithdrawals": {
      "description": "Where the owners may send funds without a Policy Engine change. Engine entry only; no role gets this.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["token", "recipients"],
        "properties": {
          "token": { "$ref": "#/$defs/address" },
          "recipients": { "type": "array", "items": { "$ref": "#/$defs/address" }, "minItems": 1 }
        }
      }
    },
    "infrastructure": {
      "description": "Replace a canonical contract, e.g. SafeL2 v1.5.0 on an L2. Defaults: the canonical v1.5.0 / Zodiac deployments.",
      "type": "object",
      "properties": {
        "safeSingleton": { "$ref": "#/$defs/address" },
        "safeProxyFactory": { "$ref": "#/$defs/address" },
        "fallbackHandler": { "$ref": "#/$defs/address" },
        "moduleProxyFactory": { "$ref": "#/$defs/address" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "amount": {
      "description": "Decimal string in token units, e.g. \"800\" or \"0.4\". Converted with the token's decimals().",
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "decimals": {
      "description": "Token decimals, only needed when the token is not deployed on the chain yet.",
      "type": "integer",
      "minimum": 0,
      "maximum": 77
    },
    "permission": {
      "oneOf": [
        {
          "description": "Call these functions on this contract, with any arguments. No ETH value. Not for token transfers or approvals.",
          "type": "object",
          "required": ["kind", "target", "functions"],
          "properties": {
            "kind": { "const": "call" },
            "target": { "$ref": "#/$defs/address" },
            "functions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*\\([^ ]*\\)$" }
            }
          }
        },
        {
          "description": "token.transfer(to, amount) to listed recipients, optionally capped per transaction and per period.",
          "type": "object",
          "required": ["kind", "token", "recipients"],
          "properties": {
            "kind": { "const": "transfer" },
            "token": { "$ref": "#/$defs/address" },
            "recipients": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/address" } },
            "maxPerTx": { "$ref": "#/$defs/amount" },
            "maxPerPeriod": { "$ref": "#/$defs/amount" },
            "period": { "description": "Seconds; required with maxPerPeriod.", "type": "integer", "minimum": 1 },
            "decimals": { "$ref": "#/$defs/decimals" }
          },
          "dependentRequired": { "maxPerPeriod": ["period"] }
        },
        {
          "description": "token.approve(spender, amount) for listed spenders, at most maxAmount.",
          "type": "object",
          "required": ["kind", "token", "spenders", "maxAmount"],
          "properties": {
            "kind": { "const": "approve" },
            "token": { "$ref": "#/$defs/address" },
            "spenders": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/address" } },
            "maxAmount": { "$ref": "#/$defs/amount" },
            "decimals": { "$ref": "#/$defs/decimals" }
          }
        }
      ]
    }
  }
}
